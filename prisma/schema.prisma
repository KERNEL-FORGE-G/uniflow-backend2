// UniFlow - Schéma de base de données
// Backend + BD - KERNEL FORGE

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS - Rôles et statuts
// ============================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  DIRECTION
  SECRETARIAT
  ENSEIGNANT
  DELEGUE
  ETUDIANT
}

enum StudentStatus {
  ACTIVE
  SUSPENDED
  GRADUATED
  WITHDRAWN
  DEFERRED
}

// ============================================================
// (Dev A) - Identité & Utilisateurs
// ============================================================

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String
  refreshTokenHash String?
  role             UserRole
  isActive         Boolean  @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  student Student?
  teacher Teacher?

  notifications            Notification[]
  hostedConferences        VideoConference[]
  conferenceParticipations ConferenceParticipant[]

  @@map("users")
}

model Student {
  id        String        @id @default(uuid())
  userId    String        @unique
  user      User          @relation(fields: [userId], references: [id])
  firstName String
  lastName  String
  matricule String        @unique
  status    StudentStatus @default(ACTIVE)

  levelId     String
  level       Level      @relation(fields: [levelId], references: [id])
  specialtyId String?
  specialty   Specialty? @relation(fields: [specialtyId], references: [id])

  enrollments       Enrollment[]
  attendanceRecords AttendanceRecord[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("students")
}

model Teacher {
  id        String @id @default(uuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id])
  firstName String
  lastName  String

  ueAssignments TeacherUeAssignment[]
  courses       Course[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("teachers")
}

// ============================================================
// (Dev A) - Structure académique
// ============================================================

model Faculty {
  id          String  @id @default(uuid())
  name        String
  nameEn      String?
  description String?

  departments Department[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("faculties")
}

model Department {
  id        String  @id @default(uuid())
  name      String
  nameEn    String?
  facultyId String
  faculty   Faculty @relation(fields: [facultyId], references: [id])

  programs Program[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("departments")
}

model Program {
  id           String     @id @default(uuid())
  name         String
  nameEn       String?
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  levels Level[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("programs")
}

model Level {
  id        String  @id @default(uuid())
  name      String
  nameEn    String?
  programId String
  program   Program @relation(fields: [programId], references: [id])

  specialties   Specialty[]
  teachingUnits TeachingUnit[]
  students      Student[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("levels")
}

model Specialty {
  id      String  @id @default(uuid())
  name    String
  nameEn  String?
  levelId String
  level   Level   @relation(fields: [levelId], references: [id])

  teachingUnits UeSpecialty[]
  students      Student[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("specialties")
}

// ============================================================
// (Dev A) - Semestres, UE, Inscriptions
// ============================================================

enum UEType {
  OBLIGATOIRE
  OPTIONNELLE
}

enum EnrollmentStatus {
  PENDING
  VALIDATED
  REJECTED
}

model Semester {
  id        String   @id @default(uuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)

  teachingUnits TeachingUnit[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("semesters")
}

model TeachingUnit {
  id      String  @id @default(uuid())
  code    String  @unique
  name    String
  nameEn  String?
  credits Int
  hoursCM Int     @default(0)
  hoursTD Int     @default(0)
  hoursTP Int     @default(0)
  type    UEType  @default(OBLIGATOIRE)

  levelId String
  level   Level  @relation(fields: [levelId], references: [id])

  semesterId String
  semester   Semester @relation(fields: [semesterId], references: [id])

  specialties        UeSpecialty[]
  enrollments        Enrollment[]
  teacherAssignments TeacherUeAssignment[]
  courses            Course[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("teaching_units")
}

model UeSpecialty {
  teachingUnitId String
  teachingUnit   TeachingUnit @relation(fields: [teachingUnitId], references: [id])
  specialtyId    String
  specialty      Specialty    @relation(fields: [specialtyId], references: [id])

  @@id([teachingUnitId, specialtyId])
  @@map("ue_specialties")
}

model Enrollment {
  id             String           @id @default(uuid())
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id])
  teachingUnitId String
  teachingUnit   TeachingUnit     @relation(fields: [teachingUnitId], references: [id])
  status         EnrollmentStatus @default(PENDING)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([studentId, teachingUnitId])
  @@map("enrollments")
}

model TeacherUeAssignment {
  id             String       @id @default(uuid())
  teacherId      String
  teacher        Teacher      @relation(fields: [teacherId], references: [id])
  teachingUnitId String
  teachingUnit   TeachingUnit @relation(fields: [teachingUnitId], references: [id])

  createdAt DateTime @default(now())

  @@unique([teacherId, teachingUnitId])
  @@map("teacher_ue_assignments")
}

// ============================================================
// (Dev A) - Notifications
// ============================================================

enum NotificationType {
  INFO
  ALERT
  ANNOUNCEMENT
}

enum NotificationChannel {
  IN_APP
  PUSH
  SMS
}

model Notification {
  id      String              @id @default(uuid())
  userId  String
  user    User                @relation(fields: [userId], references: [id])
  title   String
  message String
  type    NotificationType    @default(INFO)
  channel NotificationChannel @default(IN_APP)
  isRead  Boolean             @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("notifications")
}

// ============================================================
// (Dev B) - Planification : Salles, Cours, Emplois du temps
// ============================================================

enum ClassroomType {
  AMPHITHEATRE
  SALLE_TD
  LABORATOIRE
}

enum CourseType {
  CM
  TD
  TP
}

enum DayOfWeek {
  LUNDI
  MARDI
  MERCREDI
  JEUDI
  VENDREDI
  SAMEDI
  DIMANCHE
}

model Classroom {
  id       String        @id @default(uuid())
  name     String        @unique
  building String?
  capacity Int
  type     ClassroomType

  courses Course[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("classrooms")
}

model Course {
  id             String       @id @default(uuid())
  teachingUnitId String
  teachingUnit   TeachingUnit @relation(fields: [teachingUnitId], references: [id])
  teacherId      String
  teacher        Teacher      @relation(fields: [teacherId], references: [id])
  classroomId    String
  classroom      Classroom    @relation(fields: [classroomId], references: [id])
  type           CourseType
  groupLabel     String?

  schedules          Schedule[]
  attendanceSessions AttendanceSession[]
  videoConferences   VideoConference[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("courses")
}

model Schedule {
  id        String    @id @default(uuid())
  courseId  String
  course    Course    @relation(fields: [courseId], references: [id])
  dayOfWeek DayOfWeek
  startTime DateTime  @db.Time
  endTime   DateTime  @db.Time

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("schedules")
}

// ============================================================
// (Dev A) - Présences
// ============================================================

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model AttendanceSession {
  id       String   @id @default(uuid())
  courseId String
  course   Course   @relation(fields: [courseId], references: [id])
  date     DateTime
  qrToken  String   @unique @default(uuid())

  records AttendanceRecord[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("attendance_sessions")
}

model AttendanceRecord {
  id        String            @id @default(uuid())
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id])
  studentId String
  student   Student           @relation(fields: [studentId], references: [id])
  status    AttendanceStatus  @default(ABSENT)
  markedAt  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([sessionId, studentId])
  @@map("attendance_records")
}

// ============================================================
// (Dev C) - Visioconférence
// ============================================================

enum ConferenceMode {
  LAN
  INTERNET
}

enum ConferenceStatus {
  ACTIVE
  ENDED
}

model VideoConference {
  id     String @id @default(uuid())
  hostId String
  host   User   @relation(fields: [hostId], references: [id])

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id])

  apiKey             String
  apiSecretEncrypted String

  mode   ConferenceMode   @default(LAN)
  status ConferenceStatus @default(ACTIVE)

  localUrl  String?
  publicUrl String?

  maxParticipants Int?

  participants ConferenceParticipant[]

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("video_conferences")
}

model ConferenceParticipant {
  id           String          @id @default(uuid())
  conferenceId String
  conference   VideoConference @relation(fields: [conferenceId], references: [id])
  userId       String
  user         User            @relation(fields: [userId], references: [id])

  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  @@map("conference_participants")
}

// ============================================================
// (Dev D) - Sécurité & Traçabilité (Audit Logs - §9.4 CDC)
// ============================================================

model AuditLog {
  id         String    @id @default(uuid())
  userId     String?
  userRole   UserRole?
  action     String
  resource   String
  resourceId String?
  ipAddress  String?
  userAgent  String?
  statusCode Int?
  details    Json?

  createdAt DateTime @default(now())

  @@map("audit_logs")
}

enum EntityType {
  STUDENT
  TEACHER
  COURSE
  UE
  CONFERENCE
}

model Attachment {
  id       String @id @default(uuid())
  url      String
  publicId String
  filename String
  mimeType String
  size     Int

  entityType EntityType
  entityId   String

  createdAt DateTime @default(now())

  @@map("attachments")
}

// ============================================================
// BACKEND 2 : INDÉPENDANTS / SAAS AUTO-GÉRÉ (SOLO / NEON DB)
// ============================================================

enum AccountType {
  PERSONAL
}

enum PersonalUserRole {
  INDEPENDENT_STUDENT
  INDEPENDENT_TEACHER
  TUTOR
}

enum SubscriptionStatus {
  PENDING
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PaymentCurrency {
  XAF
  EUR
  USD
}

enum PaymentProvider {
  CINETPAY
  NOTCHPAY
  MTN_MOMO
  ORANGE_MONEY
  STRIPE
  CARD
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

model PersonalUser {
  id                String           @id @default(uuid())
  email             String           @unique
  passwordHash      String
  firstName         String
  lastName          String
  role              PersonalUserRole @default(INDEPENDENT_STUDENT)
  phone             String?
  avatarUrl         String?
  countryCode       String           @default("CM") @db.VarChar(5)
  preferredCurrency PaymentCurrency  @default(XAF)
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @default(now()) @updatedAt

  subscription        Subscription?
  paymentTransactions PaymentTransaction[]
  personalSubjects    PersonalSubject[]
  personalSchedules   PersonalSchedule[]
  personalGrades      PersonalGrade[]
  personalTasks       PersonalTask[]

  @@map("personal_users")
}

model SubscriptionPlan {
  id               String            @id @default(uuid())
  code             String            @unique
  name             String
  category         String
  description      String?
  priceMonthlyXaf  Decimal           @db.Decimal(10, 2)
  priceAnnuallyXaf Decimal           @db.Decimal(10, 2)
  priceMonthlyEur  Decimal           @db.Decimal(10, 2)
  priceAnnuallyEur Decimal           @db.Decimal(10, 2)
  period           String?
  features         Json
  providers        PaymentProvider[]
  btnText          String?
  btnVariant       String?
  highlight        Boolean           @default(false)
  badge            String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                     String             @id @default(uuid())
  userId                 String             @unique
  user                   PersonalUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  planCode               String?
  plan                   SubscriptionPlan?  @relation(fields: [planCode], references: [code], onDelete: SetNull)
  status                 SubscriptionStatus @default(PENDING)
  countryCode            String             @default("CM") @db.VarChar(5)
  currency               PaymentCurrency    @default(XAF)
  monthlyAmount          Decimal            @default(100.00) @db.Decimal(10, 2)
  currentPeriodStart     DateTime           @default(now())
  currentPeriodEnd       DateTime           @default(now())
  cancelAtPeriodEnd      Boolean            @default(false)
  paymentProvider        PaymentProvider?   @default(NOTCHPAY)
  externalSubscriptionId String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @default(now()) @updatedAt

  paymentTransactions PaymentTransaction[]

  @@map("subscriptions")
}

model PaymentTransaction {
  id                     String          @id @default(uuid())
  subscriptionId         String
  subscription           Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  userId                 String
  user                   PersonalUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount                 Decimal         @db.Decimal(10, 2)
  currency               PaymentCurrency
  provider               PaymentProvider
  providerTransactionRef String?
  status                 String          @default("PENDING")
  metadata               Json?
  createdAt              DateTime        @default(now())

  @@map("payment_transactions")
}

model PersonalSubject {
  id             String       @id @default(uuid())
  userId         String
  user           PersonalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  code           String
  name           String
  instructorName String?
  credits        Int?         @default(3)
  colorHex       String?      @default("#1e3a8a")
  semesterLabel  String?      @default("Semestre 1")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  personalSchedules PersonalSchedule[]
  personalGrades    PersonalGrade[]
  personalTasks     PersonalTask[]

  @@map("personal_subjects")
}

model PersonalSchedule {
  id                String          @id @default(uuid())
  userId            String
  user              PersonalUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId         String
  subject           PersonalSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  dayOfWeek         DayOfWeek
  startTime         String
  endTime           String
  classroomLocation String?
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @default(now()) @updatedAt

  @@map("personal_schedules")
}

model PersonalGrade {
  id              String          @id @default(uuid())
  userId          String
  user            PersonalUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId       String
  subject         PersonalSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  evaluationTitle String
  score           Decimal         @db.Decimal(4, 2)
  maxScore        Decimal         @default(20.00) @db.Decimal(4, 2)
  coefficient     Decimal         @default(1.00) @db.Decimal(3, 2)
  evaluationDate  DateTime?       @db.Date
  createdAt       DateTime        @default(now())

  @@map("personal_grades")
}

model PersonalTask {
  id          String           @id @default(uuid())
  userId      String
  user        PersonalUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId   String?
  subject     PersonalSubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  title       String
  description String?
  dueDate     DateTime?
  priority    TaskPriority     @default(MEDIUM)
  status      TaskStatus       @default(TODO)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt

  @@map("personal_tasks")
}
